---
// GitHub, LinkedIn, e-mail and (once the PDFs exist) the résumé.
import { profile } from '../data/profile';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { github, linkedin, email, cv } = profile.links;
---

<ul aria-label={t.links.nav}>
  <li>
    <a href={github} rel="noopener noreferrer">
      {t.links.github}
    </a>
  </li>
  <li>
    <a href={linkedin} rel="noopener noreferrer">
      {t.links.linkedin}
    </a>
  </li>
  <li>
    <a href={`mailto:${email}`}>{t.links.email}</a>
  </li>
  {cv && (
    <li>
      <a href={cv[locale]} type="application/pdf">
        {t.links.cv}
      </a>
    </li>
  )}
</ul>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    min-block-size: 24px;
  }
</style>
