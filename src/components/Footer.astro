---
// Versioned footer: real data from the pipeline that published this build.
import { build, buildDate, buildYear, repoUrl } from '../data/build';
import { profile } from '../data/profile';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="container mono">
  <p class="build">
    {build ? (
      <>
        <span>
          {t.footer.build}{' '}
          <a href={build.commitUrl} rel="noopener noreferrer">
            {build.shortSha}
            <span class="visually-hidden"> — {t.footer.commitLabel}</span>
          </a>
        </span>
        <span>
          {t.footer.deploy} <time datetime={buildDate}>{buildDate}</time>
        </span>
        <a href={build.runUrl} rel="noopener noreferrer">
          {t.footer.ci}
          <span class="visually-hidden"> — {t.footer.ciLabel}</span>
        </a>
      </>
    ) : (
      <span>
        {t.footer.localBuild} <time datetime={buildDate}>{buildDate}</time>
      </span>
    )}
    <a href={repoUrl} rel="noopener noreferrer">
      {t.footer.source}
    </a>
  </p>
  <p>
    © {buildYear} {profile.name}
  </p>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
    margin-block-start: var(--space-2xl);
    padding-block: var(--space-m) var(--space-l);
    border-block-start: var(--rule-width) solid var(--rule);
    color: var(--fg-muted);
  }

  .build {
    display: flex;
    flex-wrap: wrap;
  }

  .build > * + *::before {
    content: '·';
    /* inline-block keeps the link underline off the separator */
    display: inline-block;
    margin-inline: var(--space-xs);
    color: var(--fg-muted);
  }

  a {
    color: inherit;
  }

  a:hover {
    color: var(--link);
  }
</style>
