---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import {
  defaultLocale,
  htmlLang,
  locales,
  ogLocale,
  pathFor,
  useTranslations,
  type Locale,
  type Route,
} from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Omitted on pages without a URL of their own (the 404): no canonical, no alternates. */
  route?: Route;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  /** Schema.org structured data, rendered as JSON-LD (data, not executable JS). */
  jsonLd?: Record<string, unknown>;
}

const { locale, route, title, description, ogType = 'website', jsonLd } = Astro.props;
const t = useTranslations(locale);
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = route && absolute(pathFor(locale, route));
// One share image per language, generated by `npm run og` (scripts/og-images.ts).
const ogImage = absolute(`/og/og-${locale}.png`);
// "</" inside JSON would end the <script> element early.
const jsonLdText = jsonLd && JSON.stringify(jsonLd).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {route && (
      <>
        <link rel="canonical" href={canonical} />
        {locales.map((code) => (
          <link rel="alternate" hreflang={htmlLang[code]} href={absolute(pathFor(code, route))} />
        ))}
        <link rel="alternate" hreflang="x-default" href={absolute(pathFor(defaultLocale, route))} />
      </>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale[locale]} />
    {locales
      .filter((code) => code !== locale)
      .map((code) => (
        <meta property="og:locale:alternate" content={ogLocale[code]} />
      ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}

    <link
      rel="preload"
      href="/fonts/mona-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#content">
      {t.layout.skipToContent}
    </a>
    <Header locale={locale} route={route} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
